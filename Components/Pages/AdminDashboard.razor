            adminName = await JS.InvokeAsync<string>("localStorage.getItem", "userName") ?? "Администратор";
            var userRole = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");

            if (userRole != "Admin")
            {
                if (userRole == "Manager")
                {
                    Navigation.NavigateTo("/manager", true);
                }
                else
                {
                    Navigation.NavigateTo("/", true);
                }
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            Navigation.NavigateTo("/login", true);
