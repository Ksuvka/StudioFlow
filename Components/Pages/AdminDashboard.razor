    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e.Value != null && DateTime.TryParse(e.Value.ToString(), out DateTime date))
        {
            selectedDate = date;
            await LoadBookingsByDate();
        }
    }

private async Task LoadBookingsByDate()
{
    if (!selectedDate.HasValue) return;
    
    selectedDateBookings = allBookings
        .Where(b => b.BookingDate.Date == selectedDate.Value.Date)
        .OrderBy(b => b.SlotTime)
        .ToList();
    
    selectedDateTotal = selectedDateBookings
        .Where(b => b.Status == "confirmed" || b.Status == "completed")
        .Sum(b => b.TotalPrice);
    
    StateHasChanged();
}

  private async Task GenerateReport()
{
    if (!selectedDate.HasValue || !selectedDateBookings.Any()) return;
    
    try
    {
        var totalForReport = selectedDateBookings
            .Where(b => b.Status == "confirmed" || b.Status == "completed")
            .Sum(b => b.TotalPrice);

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html>");
        sb.AppendLine("<head>");
        sb.AppendLine("<meta charset='UTF-8'>");
        sb.AppendLine("<title>Отчет о бронированиях</title>");
        sb.AppendLine("<style>");
        sb.AppendLine("body { font-family: Arial, sans-serif; margin: 40px; background: #fff; }");
        sb.AppendLine("h1 { color: #333; border-bottom: 2px solid #ffd700; padding-bottom: 10px; }");
        sb.AppendLine("h2 { color: #555; margin-top: 20px; }");
        sb.AppendLine("table { border-collapse: collapse; width: 100%; margin-top: 20px; }");
        sb.AppendLine("th, td { border: 1px solid #ddd; padding: 12px 10px; text-align: left; vertical-align: top; }");
        sb.AppendLine("th { background-color: #f5f5f5; font-weight: bold; }");
        sb.AppendLine("tr:nth-child(even) { background-color: #f9f9f9; }");
        sb.AppendLine(".total { font-weight: bold; margin-top: 20px; font-size: 18px; text-align: right; }");
        sb.AppendLine(".footer { margin-top: 30px; text-align: center; color: #888; font-size: 12px; }");
        sb.AppendLine(".status-cancelled { color: #dc3545; }");
        sb.AppendLine(".status-pending { color: #ffc107; }");
        sb.AppendLine(".status-confirmed { color: #28a745; }");
        sb.AppendLine(".status-completed { color: #17a2b8; }");
        sb.AppendLine("</style>");
        sb.AppendLine("</head>");
        sb.AppendLine("<body>");
        sb.AppendLine($"<h1>Отчет о бронированиях</h1>");
        sb.AppendLine($"<h2>Дата: {selectedDate.Value:dd.MM.yyyy}</h2>");
        
        sb.AppendLine("<table>");
        sb.AppendLine("<thead>");
        sb.AppendLine("<tr>");
        sb.AppendLine("<th>Время</th>");
        sb.AppendLine("<th>Студия</th>");
        sb.AppendLine("<th>Клиент</th>");
        sb.AppendLine("<th>Оборудование</th>");
        sb.AppendLine("<th>Сумма</th>");
        sb.AppendLine("<th>Статус</th>");
        sb.AppendLine("</tr>");
        sb.AppendLine("</thead>");
        sb.AppendLine("<tbody>");
        
        foreach (var booking in selectedDateBookings)
        {
            var equipment = booking.EquipmentList.Any() 
                ? string.Join(", ", booking.EquipmentList.Select(e => $"{e.Name} x{e.Quantity}"))
                : "—";
            
            var statusText = GetStatusText(booking.Status);
            var statusClass = "";
            
            switch (booking.Status)
            {
                case "cancelled":
                    statusClass = "status-cancelled";
                    break;
                case "pending":
                    statusClass = "status-pending";
                    break;
                case "confirmed":
                    statusClass = "status-confirmed";
                    break;
                case "completed":
                    statusClass = "status-completed";
                    break;
            }
            
            sb.AppendLine("<tr>");
            sb.AppendLine($"<td>{booking.SlotTime}</td>");
            sb.AppendLine($"<td>{System.Net.WebUtility.HtmlEncode(booking.StudioName)}</td>");
            sb.AppendLine($"<td>{System.Net.WebUtility.HtmlEncode(booking.ClientName)}</td>");
            sb.AppendLine($"<td>{System.Net.WebUtility.HtmlEncode(equipment)}</td>");
            sb.AppendLine($"<td>{booking.TotalPrice:N0} ₽</td>");
            sb.AppendLine($"<td class='{statusClass}'>{statusText}</td>");
            sb.AppendLine("</tr>");
        }
        
        sb.AppendLine("</tbody>");
        sb.AppendLine("</table>");
        sb.AppendLine($"<div class='total'>Общая выручка: {totalForReport:N0} ₽</div>");
        sb.AppendLine("<div class='footer'>Отчет сгенерирован " + DateTime.Now.ToString("dd.MM.yyyy HH:mm") + "</div>");
        sb.AppendLine("</body>");
        sb.AppendLine("</html>");
        
        var html = sb.ToString();
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
        var dataUrl = $"data:application/vnd.ms-excel;base64,{base64}";
        
        await JS.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.download = 'report_{selectedDate.Value:yyyyMMdd}.html';
            link.href = '{dataUrl}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
        
        await JS.InvokeVoidAsync("alert", $"Отчет за {selectedDate.Value:dd.MM.yyyy} успешно сформирован");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error generating report: {ex.Message}");
        await JS.InvokeVoidAsync("alert", "Ошибка при формировании отчета");
    }
}
