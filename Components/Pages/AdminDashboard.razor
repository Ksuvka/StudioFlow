private string GetStatusText(string status) => status switch
{
    "pending" => "Ожидает",
    "confirmed" => "Подтверждено",
    "paid" => "Оплачено",
    "completed" => "Завершено",
    "cancelled" => "Отменено",
    _ => status
};

    private List<ManagerBookingViewModel> filteredAllBookings => allBookings
        .Where(b => (bookingStatusFilter == "all" || b.Status == bookingStatusFilter) &&
                    (string.IsNullOrEmpty(bookingSearchTerm) ||
                     b.ClientName.Contains(bookingSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                     b.StudioName.Contains(bookingSearchTerm, StringComparison.OrdinalIgnoreCase)) &&
                    (!historyDateFilter.HasValue || b.BookingDate.Date == historyDateFilter.Value.Date))
        .OrderByDescending(b => b.BookingDate)
        .ToList();

    private List<ClientViewModel> filteredClientsList => allClients
        .Where(c => string.IsNullOrEmpty(clientSearchTerm) ||
                    c.FullName.Contains(clientSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Email.Contains(clientSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (c.Phone?.Contains(clientSearchTerm) ?? false))
        .OrderBy(c => c.FullName)
        .ToList();

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userEmail");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("localStorage.removeItem", "isAuthenticated");

        AppStateService.IsAuthenticated = false;
        AppStateService.UserName = "";
        Navigation.NavigateTo("/", true);
    }

 
public class PricingRuleViewModel
{
    public int RuleId { get; set; }
    public int? StudioId { get; set; }
    public string? StudioName { get; set; }

    public int? DayOfWeek { get; set; }
    public string? DayOfWeekName { get; set; }

    public string? StartTime { get; set; }  
    public string? EndTime { get; set; }   

    public string? TimeRange { get; set; }

    public decimal Multiplier { get; set; }

    public bool IsActive { get; set; }

    public string? Description { get; set; }
}}