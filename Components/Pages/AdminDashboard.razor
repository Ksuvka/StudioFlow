@page "/admin"
@rendermode InteractiveServer
@using StudioFlow.Services
@using StudioFlow.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AppStateService AppStateService
@inject AuthService AuthService

<PageTitle>StudioFlow - Администратор</PageTitle>
<link rel="stylesheet" href="css/admin.css" />


<div class="admin-container">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 50px;">
            <div class="loader"></div>
            <h3 style="color: var(--text-gray); margin-top: 20px;">Загрузка...</h3>
        </div>
    }
    else
    {
        <div class="admin-card">
            <!-- Шапка -->
            <div class="admin-header">
                <div class="admin-header-info">
                    <h1>@adminName</h1>
                    <p>Панель администратора</p>
                </div>
                <button class="btn-logout" @onclick="Logout">Выйти</button>
            </div>

            <div class="admin-tabs">
                <button class="tab-btn @(activeTab == "bookings" ? "active" : "")" @onclick="ShowBookingsTab">
                    Бронирования
                </button>
                <button class="tab-btn @(activeTab == "studios" ? "active" : "")" @onclick="ShowStudiosTab">
                    Залы
                </button>
                <button class="tab-btn @(activeTab == "equipment" ? "active" : "")" @onclick="ShowEquipmentTab">
                    Оборудование
                </button>
                <button class="tab-btn @(activeTab == "pricing" ? "active" : "")" @onclick="ShowPricingTab">
                    Цены
                </button>
                <button class="tab-btn @(activeTab == "clients" ? "active" : "")" @onclick="ShowClientsTab">
                    Клиенты
                </button>
            </div>

            <div class="admin-content">
                <!-- Вкладка: Бронирования -->
                @if (activeTab == "bookings")
                {
                    <div class="bookings-tab">
                        <!-- Блок выбора даты -->
                        <div class="date-selector-section">
                            
                            <div class="date-controls">
                                <input type="date" value="@selectedDate?.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" class="date-input" />
                            <button class="btn-success" @onclick="GenerateReport" disabled="@(selectedDateBookings == null || !selectedDateBookings.Any())">
                                Сформировать отчет
                            </button>
                            </div>
                        </div>

                        <!-- Статистика за выбранный день -->
                        @if (selectedDateBookings != null)
                        {
                            <div class="day-stats">
                                <div class="stat-card">
                                    <div class="stat-info">
                                        <div class="stat-label">Выбранная дата</div>
                                        <div class="stat-value">@selectedDate?.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-info">
                                        <div class="stat-label">Всего броней</div>
                                        <div class="stat-value">@selectedDateBookings.Count</div>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-info">
                                        <div class="stat-label">Выручка за день</div>
                                        <div class="stat-value">@selectedDateTotal.ToString("N0") ₽</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Таблица бронирований за выбранный день -->
                            <div class="daily-bookings-section">
                                <h3 class="label-date">Бронирования на @selectedDate?.ToString("dd.MM.yyyy")</h3>
                                @if (selectedDateBookings.Any())
                                {
                                    <div class="bookings-list">
                                        @foreach (var booking in selectedDateBookings)
                                        {
                                            <div class="booking-card">
                                                <div class="booking-card-header">
                                                    <div class="booking-time"> @booking.SlotTime</div>
                                                    <div class="booking-status status-@booking.Status">@GetStatusText(booking.Status)</div>
                                                </div>
                                                <div class="booking-card-body">
                                                    <div class="booking-row">
                                                        <span class="label">Студия:</span>
                                                        <span class="value">@booking.StudioName</span>
                                                    </div>
                                                    <div class="booking-row">
                                                        <span class="label">Клиент:</span>
                                                        <span class="value">@booking.ClientName</span>
                                                    </div>
                                                    <div class="booking-row">
                                                        <span class="label">Оборудование:</span>
                                                        <span class="value">
                                                            @if (booking.EquipmentList.Any())
                                                            {
                                                                @string.Join(", ", booking.EquipmentList.Select(e => $"{e.Name} x{e.Quantity}"))
                                                            }
                                                            else
                                                            {
                                                                <span class="text-gray">—</span>
                                                            }
                                                        </span>
                                                    </div>
                                                    <div class="booking-row">
                                                        <span class="label">Сумма:</span>
                                                        <span class="value price">@booking.TotalPrice.ToString("N0") ₽</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(booking.Comment))
                                                    {
                                                        <div class="booking-comment">
                                                             @booking.Comment
                                                        </div>
                                                    }
                                                </div>
                                                <div class="booking-card-actions">
                                                    <button class="btn-small btn-details" @onclick="() => ViewBookingDetails(booking)">Детали</button>
                                                    @if (booking.Status == "pending")
                                                    {
                                                        <button class="btn-small btn-confirm" @onclick="() => ConfirmBooking(booking.BookingId)">Подтвердить</button>
                                                    }
                                                    @if (booking.Status != "cancelled")
                                                    {
                                                        <button class="btn-small btn-cancel" @onclick="() => CancelBooking(booking.BookingId)">Отменить</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <p>Нет бронирований на выбранную дату</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

<!-- Вкладка: Залы -->
@if (activeTab == "studios")
{
    <div class="studios-tab">
        <button class="btn-primary" @onclick="OpenStudioModal">+ Добавить зал</button>

        <div class="studios-grid">
            @foreach (var studio in studios)
            {
                <div class="studio-card @(!studio.IsActive ? "inactive" : "")">
                    <div class="studio-card-header">
                        <h3>@studio.Name</h3>
                        <div class="studio-actions">
                                <button class="btn-icon" @onclick="() => EditStudio(studio)">
                                     <img src="images/icon/edit.png" alt="Редактировать" />
                                </button>
                            <button class="btn-icon delete" @onclick="() => DeleteStudio(studio.StudioId)">
                                   <img src="images/icon/delete.png" alt="Удалить" />
                             </button>
                        </div>
                    </div>
                    <p class="studio-description">@studio.Description</p>
                   <div class="studio-details">
                        <span><strong>Адрес:</strong> @studio.Address</span>
                        <span><strong>Площадь:</strong> @studio.Area м²</span>
                        <span><strong>Потолки:</strong> @studio.CeilingHeight м</span>
                        <span><strong>Стоимость:</strong> @studio.BasePrice.ToString("N0") ₽/час</span>
                        <span>
                            <strong>Свет:</strong>
                            @(studio.HasNaturalLight ? "Естественный" : "Искусственный")
                        </span>

                        @if (!studio.IsActive)
                        {
                            <span class="inactive-badge">НЕАКТИВЕН</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

 <!-- Вкладка: Оборудование -->
@if (activeTab == "equipment")
{
    <div class="equipment-tab">
        <button class="btn-primary" @onclick="OpenEquipmentModal">+ Добавить оборудование</button>

        <div class="equipment-grid">
            @foreach (var category in equipmentByCategory)
            {
                <div class="equipment-category-section">
                    <h3>@category.Key</h3>
                    <div class="equipment-cards">
                        @foreach (var item in category.Value)
                        {
                            <div class="equipment-card">
                                <div class="equipment-card-header">
                                    <h4>@item.Name</h4>
                                    <div class="equipment-actions">
                                        <button class="btn-icon" @onclick="() => EditEquipment(item)">
                                            <img src="images/icon/edit.png" alt="Редактировать" />
                                            </button>
                                        <button class="btn-icon delete" @onclick="() => DeleteEquipmentById(item.EquipmentId)">
                                            <img src="images/icon/delete.png" alt="Удалить" />
                                            </button>
                                    </div>
                                </div>
                                <p class="equipment-description">@item.Description</p>
                                <div class="equipment-details">
                                    <span>Цена: @item.RentalPrice.ToString("N0") ₽/час</span>
                                    <span>Доступно: @item.Quantity шт.</span>
                                    @if (!item.IsActive)
                                    {
                                        <span class="inactive-badge">НЕАКТИВНО</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
 <!-- Вкладка: Цены -->
@if (activeTab == "pricing")
{
    <div class="pricing-tab">
        <button class="btn-primary" @onclick="OpenPricingRuleModal">+ Добавить правило</button>
        
        <div class="pricing-table-container">
            <table class="pricing-table">
                <thead>
                    <tr>
                        <th>Студия</th>
                        <th>День недели</th>
                        <th>Время</th>
                        <th>Множитель</th>
                        <th>Статус</th>
                        <th>Описание</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in pricingRules)
                    {
                        <tr>
                            <td>@(rule.StudioName ?? "Все студии")</td
                            <td>@(rule.DayOfWeekName ?? "Все дни")</td
                            <td>@(rule.TimeRange ?? "Весь день")</td
                            <td>@(rule.Multiplier.ToString("F2"))</td
                            <td>
                                <span class="status-badge @(rule.IsActive ? "status-active" : "status-inactive")">
                                    @(rule.IsActive ? "Активен" : "Неактивен")
                                </span>
                            </td
                            <td>@rule.Description</td
                            <td>
                                <button class="btn-icon" @onclick="() => EditPricingRule(rule)">
                                    <img src="images/icon/edit.png" alt="Редактировать" />
                                </button>
                                <button class="btn-icon delete" @onclick="() => DeletePricingRule(rule.RuleId)">
                                     <img src="images/icon/delete.png" alt="Удалить" />
                                </button>
                            </td
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

 <!-- Вкладка: Клиенты -->
                @if (activeTab == "clients")
                {
                    <div class="clients-tab">
                        <div class="search-filter">
                            <input type="text" placeholder="Поиск по имени, email, телефону..." @bind="clientSearchTerm" class="search-input" />
                        </div>

                        <div class="clients-grid">
                            @foreach (var client in filteredClientsList)
                            {
                                                            <div class="client-card">
                                <div class="client-card-header">
                                    <h3>@client.FullName</h3>
                                </div>

                                <div class="client-details">

                                    <p>
                                        <span>Почта</span>
                                        <span>@client.Email</span>
                                    </p>

                                    <p>
                                        <span>Телефон</span>
                                        <span>@(string.IsNullOrEmpty(client.Phone) ? "—" : client.Phone)</span>
                                    </p>

                                    <p>
                                        <span>Регистрация</span>
                                        <span>@client.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    </p>

                                    <p class="total-bookings">
                                        <span>Всего броней</span>
                                        <span>@client.TotalBookings</span>
                                    </p>

                                    <p class="total-spent">
                                        <span>Потрачено</span>
                                        <span>@client.TotalSpent.ToString("N0") ₽</span>
                                    </p>

                                </div>

                                <button class="btn-details"
                                        @onclick="() => ViewClientBookings(client)">
                                    История бронирований
                                </button>
                            </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Модальное окно деталей бронирования -->
    @if (isBookingDetailsModalOpen && selectedBookingForModal != null)
    {
        <div class="modal-overlay active" @onclick="CloseBookingDetailsModal">
            <div class="modal-content booking-details-modal" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="CloseBookingDetailsModal">×</button>
                
                <h3 style="color: var(--gold); margin-bottom: 20px;">Детали бронирования #@selectedBookingForModal.BookingId</h3>
      

                <div class="booking-details-grid">
                    <div class="detail-item">
                        <span class="detail-label">Клиент:</span>
                        <span class="detail-value">@selectedBookingForModal.ClientName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Студия:</span>
                        <span class="detail-value">@selectedBookingForModal.StudioName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Дата:</span>
                        <span class="detail-value">@selectedBookingForModal.BookingDate.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Время:</span>
                        <span class="detail-value">@selectedBookingForModal.SlotTime</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Статус:</span>
                        <span class="detail-value status-@selectedBookingForModal.Status">@GetStatusText(selectedBookingForModal.Status)</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Сумма:</span>
                        <span class="detail-value price">@selectedBookingForModal.TotalPrice.ToString("N0") ₽</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(selectedBookingForModal.Comment))
                {
                    <div class="detail-comment">
                        <span class="detail-label">Комментарий:</span>
                        <p class="detail-value">@selectedBookingForModal.Comment</p>
                    </div>
                }

                <div class="detail-equipment">
                    <span class="detail-label">Оборудование:</span>
                    @if (selectedBookingForModal.EquipmentList.Any())
                    {
                        <div class="equipment-list-modal">
                            @foreach (var eq in selectedBookingForModal.EquipmentList)
                            {
                                <div class="equipment-item-modal">
                                    <span>@eq.Name</span>
                                    <span>x @eq.Quantity</span>
                                    <span class="eq-price">@((eq.RentalPrice * eq.Quantity).ToString("N0")) ₽</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="detail-value text-gray">Оборудование не выбрано</p>
                    }
                </div>

                <div class="modal-actions">
                    <button class="btn-close" @onclick="CloseBookingDetailsModal">Закрыть</button>
                </div>
            </div>
        </div>
    }

    <!-- Модальное окно для залов -->
@if (isStudioModalOpen)
{
    <div class="modal-overlay active" @onclick="CloseStudioModal">
        <div class="modal-content studio-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseStudioModal">×</button>
            
            <h3 style="color: var(--gold); margin-bottom: 20px;">
                @(isEditingStudio ? "Редактирование зала" : "Добавление зала")
            </h3>
            
            <div class="studio-form">
                <div class="form-row">
                    <label>Название зала *</label>
                    <input type="text" @bind="studioEditModel.Name" class="form-input" placeholder="Например: Циклорама" />
                </div>
                
                <div class="form-row">
                    <label>Описание</label>
                    <textarea @bind="studioEditModel.Description" class="form-textarea" rows="3" placeholder="Описание зала..."></textarea>
                </div>
                
                <div class="form-row">
                    <label>Адрес</label>
                    <input type="text" @bind="studioEditModel.Address" class="form-input" placeholder="Адрес студии" />
                </div>
                
                <div class="form-row two-columns">
                    <div>
                        <label>Площадь (м²)</label>
                        <input type="number" step="0.1" @bind="studioEditModel.Area" class="form-input" placeholder="80" />
                    </div>
                    <div>
                        <label>Высота потолков (м)</label>
                        <input type="number" step="0.1" @bind="studioEditModel.CeilingHeight" class="form-input" placeholder="4.5" />
                    </div>
                </div>
                
                <div class="form-row two-columns">
                    <div>
                        <label>Цвет стен</label>
                        <input type="text" @bind="studioEditModel.WallColor" class="form-input" placeholder="Белый" />
                    </div>
                    <div>
                        <label>Стоимость (₽/час) *</label>
                        <input type="number" step="100" @bind="studioEditModel.BasePrice" class="form-input" placeholder="1500" />
                    </div>
                </div>
                
                <div class="form-row checkbox-row">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="studioEditModel.HasNaturalLight" />
                        <span>Естественное освещение</span>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="studioEditModel.IsActive" />
                        <span>Зал активен</span>
                    </label>
                </div>
                
                <div class="form-row">
                    <label>URL изображения (опционально)</label>
                    <input type="text" @bind="studioEditModel.ImageUrl" class="form-input" placeholder="/images/studios/studio.jpg" />
                </div>
            </div>
            
            <div class="modal-actions">
                <button class="btn-save" @onclick="SaveStudio">Сохранить</button>
                <button class="btn-secondary" @onclick="CloseStudioModal">Отмена</button>
            </div>
        </div>
    </div>
}
<!-- Модальное окно для оборудования -->
@if (isEquipmentModalOpen)
{
    <div class="modal-overlay active" @onclick="CloseEquipmentModal">
        <div class="modal-content equipment-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseEquipmentModal">×</button>
            
            <h3 style="color: var(--gold); margin-bottom: 20px;">
                @(isEditingEquipment ? "Редактирование оборудования" : "Добавление оборудования")
            </h3>
            
            <div class="equipment-form">
                <div class="form-row">
                    <label>Название оборудования *</label>
                    <input type="text" @bind="equipmentEditModel.Name" class="form-input" placeholder="Например: Godox AD600BM" />
                </div>
                
                <div class="form-row">
                    <label>Категория *</label>
                    <input type="text" @bind="equipmentEditModel.Category" class="form-input" placeholder="Свет, Камера, Штатив, Фон, Аудио, Стойка, Аксессуар" />
                </div>
                
                <div class="form-row">
                    <label>Описание</label>
                    <textarea @bind="equipmentEditModel.Description" class="form-textarea" rows="3" placeholder="Описание оборудования..."></textarea>
                </div>
                
                <div class="form-row two-columns">
                    <div>
                        <label>Стоимость аренды (₽/час) *</label>
                        <input type="number" step="50" @bind="equipmentEditModel.RentalPrice" class="form-input" placeholder="500" />
                    </div>
                    <div>
                        <label>Количество *</label>
                        <input type="number" step="1" @bind="equipmentEditModel.Quantity" class="form-input" placeholder="1" />
                    </div>
                </div>
                
                <div class="form-row checkbox-row">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="equipmentEditModel.IsActive" />
                        <span>Оборудование активно</span>
                    </label>
                </div>
                
                <div class="form-row">
                    <label>URL изображения (опционально)</label>
                    <input type="text" @bind="equipmentEditModel.ImageUrl" class="form-input" placeholder="/images/equipment/equipment.jpg" />
                </div>
            </div>
            
            <div class="modal-actions">
                <button class="btn-save" @onclick="SaveEquipment">Сохранить</button>
                <button class="btn-secondary" @onclick="CloseEquipmentModal">Отмена</button>
            </div>
        </div>
    </div>
}
<!-- Модальное окно для правил ценообразования -->
@if (isPricingRuleModalOpen)
{
    <div class="modal-overlay active" @onclick="ClosePricingRuleModal">
        <div class="modal-content pricing-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="ClosePricingRuleModal">×</button>
            
            <h3 style="color: var(--gold); margin-bottom: 20px;">
                @(isEditingPricingRule ? "Редактирование правила" : "Добавление правила")
            </h3>
            
            <div class="pricing-form">
                <div class="form-row">
                    <label>Студия (необязательно)</label>
                    <select @bind="pricingRuleEditModel.StudioId" class="form-input">
                        <option value="">Все студии</option>
                        @foreach (var studio in studios)
                        {
                            <option value="@studio.StudioId">@studio.Name</option>
                        }
                    </select>
                    <small class="form-hint">Если не выбрано, правило применяется ко всем студиям</small>
                </div>
                
                <div class="form-row">
                    <label>День недели (необязательно)</label>
                    <select @bind="pricingRuleEditModel.DayOfWeek" class="form-input">
                        <option value="">Все дни</option>
                        <option value="0">Воскресенье</option>
                        <option value="1">Понедельник</option>
                        <option value="2">Вторник</option>
                        <option value="3">Среда</option>
                        <option value="4">Четверг</option>
                        <option value="5">Пятница</option>
                        <option value="6">Суббота</option>
                    </select>
                    <small class="form-hint">Если не выбрано, правило применяется ко всем дням</small>
                </div>
                
                <div class="form-row two-columns">
                    <div>
                        <label>Время начала</label>
                        <input type="text" @bind="pricingRuleEditModel.StartTime" placeholder="09:00" class="form-input" />
                        <small class="form-hint">Например: 09:00</small>
                    </div>
                    <div>
                        <label>Время окончания</label>
                        <input type="text" @bind="pricingRuleEditModel.EndTime" placeholder="21:00" class="form-input" />
                        <small class="form-hint">Например: 21:00</small>
                    </div>
                </div>
                
                <div class="form-row">
                    <label>Множитель</label>
                    <input type="number" step="0.1" @bind="pricingRuleEditModel.Multiplier" class="form-input" placeholder="1.0" />
                    <small class="form-hint">Например: 1.5 (увеличивает цену на 50%)</small>
                </div>
                
                <div class="form-row">
                    <label>Описание</label>
                    <textarea @bind="pricingRuleEditModel.Description" class="form-textarea" rows="2" placeholder="Описание правила..."></textarea>
                </div>
                
                <div class="form-row checkbox-row">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="pricingRuleEditModel.IsActive" />
