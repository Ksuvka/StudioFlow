<!-- Модальное окно для истории бронирований клиента -->
@if (isClientBookingsModalOpen && selectedClientForModal != null)
{
    <div class="modal-overlay active" @onclick="CloseClientBookingsModal">
        <div class="modal-content client-bookings-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseClientBookingsModal">×</button>
            
            <h3 style="color: var(--gold); margin-bottom: 10px;">История бронирований</h3>
            <h4 style="color: var(--text-gray); margin-bottom: 20px;">@selectedClientForModal.FullName</h4>
            
            @if (selectedClientBookings.Any())
            {
                <div class="client-bookings-list">
                    <table class="client-bookings-table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Время</th>
                                <th>Студия</th>
                                <th>Оборудование</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in selectedClientBookings)
                            {
                                <tr>
                                    <td>
                                        @booking.BookingDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        @booking.SlotTime
                                    </td>

                                    <td>
                                        @booking.StudioName
                                    </td>

                                    <td>
                                        @if (booking.EquipmentList.Any())
                                        {
                                            @string.Join(", ", booking.EquipmentList.Select(e => $"{e.Name} x{e.Quantity}"))
                                        }
                                        else
                                        {
                                            <span class="text-gray">—</span>
                                        }
                                    </td>

                                    <td class="price-cell">
                                        @booking.TotalPrice.ToString("N0") ₽
                                    </td>

                                    <td>
                                        <span class="status-badge status-@booking.Status">
                                            @GetStatusText(booking.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="client-stats">
                    <div class="stat-item">
                        <span class="stat-label">Всего бронирований:</span>
                        <span class="stat-value">@selectedClientBookings.Count</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Общая сумма:</span>
                        <span class="stat-value">@selectedClientBookings.Sum(b => b.TotalPrice).ToString("N0") ₽</span>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>У клиента нет бронирований</p>
                </div>
            }
        </div>
    </div>
}
