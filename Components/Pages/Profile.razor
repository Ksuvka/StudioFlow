                    await JS.InvokeVoidAsync("alert",
                        $"Бронирование обновлено. Стоимость уменьшена на {Math.Abs(additionalPayment):N0} ₽. " +
                        "Средства будут возвращены на вашу карту в течение 5-10 рабочих дней.");
                    CloseEditBooking();
                    StateHasChanged();
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Бронирование успешно обновлено");
                    CloseEditBooking();
                    StateHasChanged();
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Не удалось обновить бронирование. Возможно, оборудование уже забронировано.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving booking: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка при сохранении изменений");
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private void GoToBooking()
    {
        Navigation.NavigateTo("/studios");
    }

    private async Task<int> GetCurrentUserId()
    {
        var id = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
        return int.TryParse(id, out int result) ? result : 0;
    }

    private string GetStatusText(string status) => status switch
    {
        "pending" => "Ожидает подтверждения",
        "confirmed" => "Подтверждено",
        "paid" => "Оплачено",
        "completed" => "Завершено",
        "cancelled" => "Отменено",
        _ => status
    };

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userEmail");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("localStorage.removeItem", "isAuthenticated");

        AppStateService.IsAuthenticated = false;
        AppStateService.UserName = "";

        Navigation.NavigateTo("/", true);
    }


    private async Task PayForBooking(UserBookingFullViewModel booking)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"💳 Оплата бронирования\n\n" +
            $"Студия: {booking.StudioName}\n" +
            $"Дата: {booking.BookingDate:dd.MM.yyyy}\n" +
            $"Время: {booking.SlotTime}\n" +
            $"Сумма: {booking.TotalPrice:N0} ₽\n\n" +
            $"Нажмите ОК для оплаты");

        if (!confirmed) return;

        try
        {
            var success = await UserService.PayForBookingAsync(booking.BookingId);

            if (success)
            {
                await JS.InvokeVoidAsync("alert", "Оплата прошла успешно!");
                var userId = await GetCurrentUserId();
                await LoadUserBookings(userId);
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Ошибка при оплате. Статус бронирования должен быть 'Подтверждено'.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error paying for booking: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка при оплате");
        }
    }
