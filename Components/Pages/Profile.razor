    private async Task<(bool CanCancel, string Message)> CanCancelBooking(UserBookingFullViewModel booking)
    {

        var startTimeMsk = await UserService.GetBookingStartTimeAsync(booking.BookingId);

        if (!startTimeMsk.HasValue)
        {
            return (false, "Не удалось определить время начала бронирования");
        }

        var nowMsk = DateTime.UtcNow.AddHours(3);

        var hoursBeforeStart = (startTimeMsk.Value - nowMsk).TotalHours;


        if (startTimeMsk.Value <= nowMsk)
        {
            return (false, "Нельзя отменить бронирование, которое уже началось или завершилось");
        }

        if (hoursBeforeStart < 12)
        {
            var remainingHours = (int)Math.Floor(hoursBeforeStart);
            var remainingMinutes = (int)((hoursBeforeStart - remainingHours) * 60);

            if (remainingHours > 0)
                return (false, $"Отмена невозможна! До начала осталось {remainingHours} ч {remainingMinutes} мин. Отменить можно не менее чем за 12 часов.");
            else
                return (false, $"Отмена невозможна! До начала осталось {remainingMinutes} мин. Отменить можно не менее чем за 12 часов.");
        }

        return (true, $" Вы можете отменить бронь. До начала осталось {hoursBeforeStart:F0} часов.");
    }

