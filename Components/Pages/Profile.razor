    private async void ChangeEquipmentQuantity(int equipmentId, int delta)
    {
        if (!editEquipmentQuantities.ContainsKey(equipmentId))
        {
            editEquipmentQuantities[equipmentId] = 0;
        }

        int currentQty = editEquipmentQuantities[equipmentId];
        int newQty = currentQty + delta;

        var equipment = availableEquipmentList.FirstOrDefault(e => e.EquipmentId == equipmentId);
        if (equipment == null) return;


        var originalQty = editingBooking?.SelectedEquipment
            .FirstOrDefault(e => e.EquipmentId == equipmentId)?.Quantity ?? 0;


        int currentTotalInUi = currentQty;


        int addedOverOriginal = currentTotalInUi - originalQty;

        int maxTotal = originalQty + equipment.AvailableQuantity;

        if (newQty >= 0 && newQty <= maxTotal)
        {
            if (newQty == 0)
            {
                editEquipmentQuantities.Remove(equipmentId);
            }
            else
            {
                editEquipmentQuantities[equipmentId] = newQty;
            }

            await RecalculateTotalPrice();
            StateHasChanged();
        }
    }




    private async Task RecalculateTotalPrice()
    {
        if (editingBooking == null) return;

        try
        {
            var equipmentWithQuantity = editEquipmentQuantities
                .Select(kvp => (EquipmentId: kvp.Key, Quantity: kvp.Value))
                .ToList();

            var newTotalPrice = await UserService.CalculatePriceWithQuantityAsync(
                editingBooking.StudioId,
                editingBooking.SlotId,
                editingBooking.BookingDate,
                equipmentWithQuantity);

            editingBooking.TotalPrice = newTotalPrice;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error recalculating price: {ex.Message}");
        }
    }


