    private async Task ToggleTimeSlot(TimeSlotViewModel slot)
    {
        if (!slot.IsAvailable) return;

        if (selectedSlots.Contains(slot))
        {
            selectedSlots.Remove(slot);
        }
        else
        {
            if (CanAddSlot(slot))
            {
                selectedSlots.Add(slot);
                selectedSlots = selectedSlots.OrderBy(s => s.StartTime).ToList();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Можно выбирать только последовательные временные слоты");
                return;
            }
        }

        await LoadAvailableEquipment();
        StateHasChanged();
    }

    private bool CanAddSlot(TimeSlotViewModel newSlot)
    {
        if (!selectedSlots.Any()) return true;

        var orderedSlots = selectedSlots.OrderBy(s => s.StartTime).ToList();
        var firstSlot = orderedSlots.First();
        var lastSlot = orderedSlots.Last();

        return newSlot.EndTime == firstSlot.StartTime || newSlot.StartTime == lastSlot.EndTime;
    }

    private string GetTimeRange()
    {
        if (!selectedSlots.Any()) return "";
        var orderedSlots = selectedSlots.OrderBy(s => s.StartTime).ToList();
        return $"{orderedSlots.First().StartTime:hh\\:mm} - {orderedSlots.Last().EndTime:hh\\:mm}";
    }

    private int GetTotalDuration() => selectedSlots.Sum(s => s.DurationMinutes);

    private decimal GetStudioPrice() => selectedSlots.Sum(s => s.Price);

    private int GetEquipmentQuantity(int equipmentId) => selectedEquipment.ContainsKey(equipmentId) ? selectedEquipment[equipmentId] : 0;

    private void ChangeEquipmentQuantity(EquipmentViewModel equipment, int delta)
    {
        var currentQty = GetEquipmentQuantity(equipment.EquipmentId);
        var newQty = currentQty + delta;
        var maxAvailable = equipment.AvailableQuantity;

        if (newQty <= 0)
        {
            selectedEquipment.Remove(equipment.EquipmentId);
        }
        else if (newQty <= maxAvailable)
        {
            selectedEquipment[equipment.EquipmentId] = newQty;
        }
        StateHasChanged();
    }

    private decimal GetEquipmentPrice()
    {
        if (!needEquipment || !selectedEquipment.Any()) return 0;
        var hours = GetTotalDuration() / 60;
        if (hours == 0) return 0;

        decimal total = 0;
        foreach (var eq in selectedEquipment)
        {
            var equipment = allEquipment.FirstOrDefault(e => e.EquipmentId == eq.Key);
            if (equipment != null)
            {
                total += equipment.RentalPrice * eq.Value * hours;
            }
        }
        return total;
    }

    private decimal GetTotalPrice() => GetStudioPrice() + GetEquipmentPrice();

    private async Task CreateBookingForClient()
    {
        if (selectedClient == null)
        {
            await JS.InvokeVoidAsync("alert", "Выберите клиента");
            return;
        }
        if (selectedStudio == null)
        {
            await JS.InvokeVoidAsync("alert", "Выберите студию");
            return;
        }
        if (!bookingDate.HasValue || !selectedSlots.Any())
        {
            await JS.InvokeVoidAsync("alert", "Выберите дату и время");
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            var equipmentList = selectedEquipment.Select(eq => (eq.Key, eq.Value)).ToList();
            bool allSuccess = true;

            foreach (var slot in selectedSlots)
            {
                var success = await UserService.CreateBookingAsync(
                    selectedClient.UserId,
                    selectedStudio.StudioId,
                    slot.SlotId,
                    bookingDate.Value,
                    bookingComment,
                    equipmentList
                );

                if (!success)
                {
                    allSuccess = false;
                    break;
                }
            }

            if (allSuccess)
            {
                await JS.InvokeVoidAsync("alert", $"Бронирование для {selectedClient.FullName} успешно создано!");
                await LoadBookings();
                selectedClient = null;
                selectedStudio = null;
                bookingDate = null;
                selectedSlots.Clear();
                selectedEquipment.Clear();
                bookingComment = "";
                activeTab = "bookings";
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Ошибка при создании бронирования");
                await LoadTimeSlots();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating booking: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка");
        }
        finally
        {
            isProcessing = false;
        }
    }

