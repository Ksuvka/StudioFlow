    }

    private async Task CancelBookingByManager(int bookingId)
    {
        var booking = allBookings.FirstOrDefault(b => b.BookingId == bookingId);
        if (booking == null) return;

        string message = booking.Status == "paid"
            ? "ВНИМАНИЕ! Бронирование оплачено. При отмене средства будут возвращены клиенту. Продолжить?"
            : "Отменить бронирование?";

        if (!await JS.InvokeAsync<bool>("confirm", message)) return;

        bool success;
        if (booking.Status == "paid")
        {
            success = await UserService.CancelPaidBookingAsync(bookingId);
        }
        else
        {
            success = await UserService.CancelBookingAsync(bookingId);
        }

        if (success)
        {
            await LoadBookings();
            await JS.InvokeVoidAsync("alert", booking.Status == "paid" ? "Бронирование отменено, средства возвращены клиенту" : "Бронирование отменено");
            StateHasChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Не удалось отменить бронирование");
        }
    }

